* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(to right, #fff3e0, #ffe0b2);
    color: #333;
    line-height: 1.6;
}

header {
    text-align: center;
    padding: 40px;
    background: #ff9800;
    color: white;
}

header h1 {
    font-size: 3rem;
}

.hero img {
    width: 100%;
    height: 400px;
    object-fit: cover;
}

section {
    padding: 40px 20px;
    max-width: 1000px;
    margin: auto;
}

h2 {
    margin-bottom: 20px;
    color: #e65100;
}

.curiosidades ul {
    list-style: square;
    padding-left: 20px;
}

.botoes {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    padding: 12px 20px;
    text-decoration: none;
    color: white;
    border-radius: 6px;
    transition: 0.3s;
}

.facebook { background: #3b5998; }
.twitter { background: #1da1f2; }
.whatsapp { background: #25d366; }

.btn:hover {
    opacity: 0.8;
}

footer {
    background: #e65100;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
}
